{
  "manifest_version": 2,
  "name": "Vulnerable Test Extension",
  "version": "1.0",
  "permissions": [
    "tabs",
    "history",
    "cookies",
    "webRequest",
    "webRequestBlocking",
    "nativeMessaging",
    "clipboardRead",
    "<all_urls>",
    "debugger"
  ],
  "background": { "scripts": ["background.js"], "persistent": true },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"]
  }],
  "externally_connectable": {
    "matches": ["*://*.github.io/*", "*://*/*"]
  },
  "web_accessible_resources": ["*.js", "*.html"]
}
