{
  "manifest_version": 2,
  "name": "EdgeClean01 Grammarly Style",
  "version": "1.0",
  "permissions": [
    "<all_urls>",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "content_security_policy": "script-src 'self'; object-src 'self'"
}
